# ---------------------------------------------------------------------------
# Smart Wildfire Intelligence System — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local setup.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Image Versions
# ---------------------------------------------------------------------------
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE_TAG=3.3.0-hadoop3.3
KAFKA_IMAGE_TAG=3.9.2
KAFKA_UI_IMAGE_TAG=latest
AIRFLOW_BASE_IMAGE=apache/airflow:2.9.3-python3.11
POSTGRES_IMAGE_TAG=13

# Spark client library version installed in Jupyter/Airflow - MUST match SPARK_IMAGE_TAG
PYSPARK_VERSION=3.3.0
# Kafka connector package for Spark streaming jobs
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.0

# ---------------------------------------------------------------------------
# Host Port Mappings (change if colliding with other local services)
# ---------------------------------------------------------------------------
NAMENODE_UI_PORT=9870
DATANODE_UI_PORT=9864
HDFS_RPC_PORT=9000

SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8081

JUPYTER_PORT=8888

KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090

POSTGRES_PORT=5432

AIRFLOW_WEBSERVER_PORT=8082

# ---------------------------------------------------------------------------
# PostgreSQL Configuration
# ---------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_dev_password
POSTGRES_DB=airflow

POSTGRES_WILD_USER=wildfire
POSTGRES_WILD_PASSWORD=wildfire_dev_password
POSTGRES_WILD_DB=wildfire

# ---------------------------------------------------------------------------
# Airflow Admin User Credentials (used when orchestration profile is active)
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_dev_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Service Endpoints (Internal Docker Network References)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9094
HDFS_NAMENODE_URL=hdfs://namenode:9000
SPARK_MASTER_URL=spark://spark-master:7077
POSTGRES_HOST=postgres
